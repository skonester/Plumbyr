<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <RootNamespace>WindowsCleaner</RootNamespace>
    <Version>1.0.3</Version>
    <Product>Plumbyr</Product>
    <AssemblyTitle>Plumbyr</AssemblyTitle>
    <Description>Plumbing Linked Universal Maintenance &amp; Binary Yield Reclaimer</Description>
    <Copyright>Copyright (C) 2026 Plumbyr contributors</Copyright>
    <NodeRuntimeDir>$(MSBuildProjectDirectory)\..\.build\node\win-x64</NodeRuntimeDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Types.fs" />
    <Compile Include="AppFiles.fs" />
    <Compile Include="Win32.fs" />
    <Compile Include="FileOperations.fs" />
    <Compile Include="ActivityLog.fs" />
    <Compile Include="CleaningHistory.fs" />
    <Compile Include="RuleLoader.fs" />
    <Compile Include="CleanTargets.fs" />
    <Compile Include="ScanEngine.fs" />
    <Compile Include="SystemInfo.fs" />
    <Compile Include="KuduBridge.fs" />
    <Compile Include="BrowserAnalysisView.fs" />
    <Compile Include="SpaceScanner.fs" />
    <Compile Include="SpaceMapView.fs" />
    <Compile Include="RecoveryService.fs" />
    <Compile Include="RecoveryView.fs" />
    <Compile Include="DriverService.fs" />
    <Compile Include="DriversView.fs" />
    <Compile Include="OptimizeService.fs" />
    <Compile Include="OptimizeView.fs" />
    <Compile Include="SleepService.fs" />
    <Compile Include="SleepPlatform.fs" />
    <Compile Include="SleepView.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\icon.png" LogicalName="Plumbyr.Payload/Assets/icon.png" />
    <EmbeddedResource Include="SpaceScanner.fs" LogicalName="Plumbyr.Notices/Roomy-SpaceScanner.fs" />
    <EmbeddedResource Include="..\.build\recovery\x86_64-pc-windows-msvc\release\plumbyr-recovery.exe" LogicalName="Plumbyr.Payload/Reclaim/plumbyr-recovery.exe" />
    <EmbeddedResource Include="Reclaim\LICENSE" LogicalName="Plumbyr.Payload/Reclaim/LICENSE" />
    <EmbeddedResource Include="Goodnight\*.ps1;Goodnight\QuickOff-LICENSE.txt" LogicalName="Plumbyr.Payload/Goodnight/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\win32rules\*.json" LogicalName="Plumbyr.Payload/win32rules/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Kudu\worker.mjs" LogicalName="Plumbyr.Payload/Kudu/worker.mjs" />
    <EmbeddedResource Include="Kudu\vendor\*.ts;Kudu\vendor\browsers.json;Kudu\vendor\LICENSE" LogicalName="Plumbyr.Payload/Kudu/vendor/%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(NodeRuntimeDir)\node.exe" LogicalName="Plumbyr.Payload/Kudu/node.exe" />
    <EmbeddedResource Include="$(NodeRuntimeDir)\LICENSE" LogicalName="Plumbyr.Payload/Kudu/NODE-LICENSE" />
  </ItemGroup>

  <Target Name="PrepareBundledNode" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RuntimeIdentifier)' != '' And '$(RuntimeIdentifier)' != 'win-x64'" Text="Bundled Node currently supports win-x64. Use the SingleFile publish profile." />
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Prepare-Node.ps1&quot;" />
  </Target>

  <Target Name="PrepareRecoveryWorker" BeforeTargets="PrepareForBuild">
    <Exec Command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\scripts\Prepare-Recovery.ps1&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="ByteSize" Version="2.1.2" />
    <PackageReference Include="FSharp.Json" Version="0.4.1" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Synthora" Version="2.5.2" />
    <PackageReference Include="System.Management" Version="10.0.7" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.7" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

</Project>
